<?xml version="1.0" encoding="utf-8"?>
<!-- 强制锁机界面：全屏显示用户设置的图片，需输入口令退出（无震动） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EE0B1020"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 强制锁机中"
            android:textColor="#1B2440"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/force_image"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="14dp"
            android:contentDescription="提醒图片"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="打开非学习软件会被拦下\n输入退出口令即可解锁"
            android:textColor="#8A93B5"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/force_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:hint="输入口令"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:singleLine="true"
            android:textColor="#1B2440"
            android:textSize="15sp" />

        <Button
            android:id="@+id/force_btn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_primary"
            android:text="解锁"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
